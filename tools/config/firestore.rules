rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isMember(leagueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }
    function isBoundedString(field, min, max) {
      return field is string && field.size() >= min && field.size() <= max;
    }
    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }
    // Verifie qu'un membre existe depuis N jours (anti-manipulation votes/trophees).
    // Grandfathered : si joinedAt manque (vieux membres pre-refonte), autorise sans check.
    function memberOlderThan(leagueId, uid, days) {
      let m = get(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid)).data;
      return exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid))
        && (!('joinedAt' in m) || m.joinedAt < request.time - duration.value(days, 'd'));
    }

    // ------------------------------------------------------------
    // LA CONDITION D ENTREE DANS LA LIGUE, et elle est seule de son espece.
    //
    // Elle tient dans UNE fonction, exprès : l entree pourra redevenir libre un jour, et
    // ce jour-la il suffira de lui faire rendre true. Ne pas la disperser dans plusieurs
    // match, ne pas la recopier.
    //
    // Ce qu elle exige : la fiche membre porte le code, ce code existe, et il a ete pris
    // par CETTE personne a l inscription. Elle ne s applique qu a la CREATION : les
    // membres deja en place mettent leur liste a jour sans rien fournir.
    // ------------------------------------------------------------
    // Exclure quelqu un. Supprimer sa fiche membre ne suffit PAS : son code d invitation
    // porte toujours son uid dans usedBy, et la regle d entree se contente de ca. Il
    // recreait sa fiche et il etait de nouveau dedans - trouve a l audit du 2026-09-28.
    // La collection se remplit A LA MAIN dans la console, un document vide par uid exclu ;
    // rien ne l ecrit depuis l appli, et c est voulu.
    function estExclu(database, leagueId) {
      return exists(/databases/$(database)/documents/leagues/$(leagueId)/blocked/$(request.auth.uid));
    }

    // Les champs d une fiche membre, et eux seuls. L ecriture etait libre jusqu au
    // 2026-09-28 : n importe quel champ, n importe quelle taille, jusqu au plafond de 1 Mo
    // par document que tous les autres membres telechargent ensuite.
    // joinedAt etait le plus genant, parce qu il sert a memberOlderThan : le delai de
    // 7 jours avant de pouvoir voter un trophee se contournait en reecrivant sa propre
    // date d arrivee. Il est gele sur update, plus bas.
    // species n est pas borne en octets - Firestore s en charge - mais en NOMBRE d entrees :
    // il y a environ 11 000 especes au monde, 20 000 laisse toute la marge utile.
    function bornesFicheMembre() {
      return (!('name'    in request.resource.data) || isBoundedString(request.resource.data.name, 0, 60))
        && (!('goal'    in request.resource.data) || isBoundedString(request.resource.data.goal, 0, 300))
        && (!('dream'   in request.resource.data) || isBoundedString(request.resource.data.dream, 0, 300))
        && (!('rare'    in request.resource.data) || isBoundedString(request.resource.data.rare, 0, 300))
        && (!('fav'     in request.resource.data) || isBoundedString(request.resource.data.fav, 0, 300))
        && (!('status'  in request.resource.data) || isBoundedString(request.resource.data.status, 0, 40))
        && (!('email'   in request.resource.data) || isBoundedString(request.resource.data.email, 0, 200))
        && (!('invite'  in request.resource.data) || isBoundedString(request.resource.data.invite, 0, 40))
        && (!('avatar'  in request.resource.data) || isBoundedString(request.resource.data.avatar, 0, 60000))
        && (!('species' in request.resource.data) || request.resource.data.species.size() <= 20000)
        && (!('favHotspots' in request.resource.data) || request.resource.data.favHotspots.size() <= 2000)
        && (!('regions' in request.resource.data) || request.resource.data.regions.size() <= 200);
    }

    function entreeAutorisee(database, leagueId) {
      return 'invite' in request.resource.data
        && request.resource.data.invite is string
        && request.resource.data.invite.size() >= 8
        && request.resource.data.invite.size() <= 40
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/invites/$(request.resource.data.invite))
        && get(/databases/$(database)/documents/leagues/$(leagueId)/invites/$(request.resource.data.invite)).data.usedBy == request.auth.uid
        && !estExclu(database, leagueId);
    }

    // ============================================================
    // /admins/{uid} : lecture publique (client verifie si user est admin)
    // ============================================================
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;   // manage via Firebase console only
    }

    // ============================================================
    // /leagues/{leagueId}
    // ============================================================
    match /leagues/{leagueId} {

      // Doc racine : lisible par signed-in (necessaire pour boot). Ecriture admin only.
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && hasOnlyKeys(['goalHeader', 'name', 'createdAt', 'updatedAt'])
        && (!('goalHeader' in request.resource.data) || isBoundedString(request.resource.data.goalHeader, 0, 200))
        && (!('name' in request.resource.data)       || isBoundedString(request.resource.data.name, 0, 100));

      // ------------------------------------------------------------
      // MEMBRES : la fiche porte le nom ET la life list complete.
      //
      // La lecture etait ouverte a tout compte connecte jusqu au 2026-09-28 : n importe qui
      // pouvait creer un compte et lire qui joue et ce que chacun avait coche. Elle est
      // desormais reservee aux membres, plus le titulaire de la fiche.
      // - isSelf : indispensable au demarrage, chacun doit pouvoir lire SA fiche avant
      //   d etre membre. C est l abonnement de app.js:5883 sur members/{monUid}.
      // - isMember : lire les autres, donc le classement, une fois inscrit.
      //
      // Consequence assumee : un connecte non membre ne peut plus LISTER la collection, donc
      // l abonnement de app.js:5877 lui est refuse. C est l etat normal de quelqu un qui
      // vient de creer son compte et n a pas encore depose sa liste : son gestionnaire
      // d erreur reste silencieux au lieu d annoncer a tort que les regles ne sont pas
      // configurees. Ce diagnostic-la vit maintenant sur l abonnement au doc de ligue, qui
      // doit reussir pour tout compte connecte.
      //
      // Effet de bord connu : le garde-fou anti-doublon de app.js:10150, qui prevenait un
      // revenant connecte avec un autre compte qu une ligne existait deja a son nom, ne voit
      // plus rien avant inscription. Voir notes-privees/ACCES-LIGUE.md.
      //
      // - Ecriture : chacun sa fiche (upload lifelist), admins peuvent tout.
      // ------------------------------------------------------------
      match /members/{memberId} {
        allow read: if isSelf(memberId) || isMember(leagueId) || isAdmin();
        // CREATION = entrer dans la ligue. Sur invitation depuis le 2026-09-28, voir
        // entreeAutorisee() plus haut. Un admin fait entrer qui il veut, sans code.
        allow create: if (isSelf(memberId) && entreeAutorisee(database, leagueId)
          && hasOnlyKeys(['name', 'species', 'regions', 'favHotspots', 'goal', 'dream',
                          'rare', 'fav', 'status', 'avatar', 'joinedAt', 'invite',
                          'updatedAt', 'email'])
          && bornesFicheMembre()) || isAdmin();
        // Mise a jour et retrait : inchanges. C est ce qui protege les membres deja en
        // place, qui n ont aucun code a fournir pour re-importer leur liste.
        // Ce qui est controle ici, ce sont les champs MODIFIES, pas la liste des champs du
        // document : une fiche ancienne peut porter un champ qu aucune version actuelle
        // n ecrit plus, et exiger la liste complete la rendrait intouchable par son
        // proprietaire, sans que rien ne le dise.
        // joinedAt et invite sont absents de la liste, et c est tout le sujet : ils se
        // posent a la creation et ne se modifient plus jamais. joinedAt commande le delai
        // de 7 jours avant de pouvoir voter un trophee (memberOlderThan).
        allow update: if isAdmin() || (
          isSelf(memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'name', 'species', 'regions', 'favHotspots', 'goal', 'dream',
               'rare', 'fav', 'status', 'avatar', 'updatedAt', 'email'])
          && bornesFicheMembre()
        );
        allow delete: if isSelf(memberId) || isAdmin();
      }

      // ------------------------------------------------------------
      // COMPTES : email du titulaire de chaque ligne du classement. Rien ne reliait
      // une ligne a un compte - la cle du document membre est l UID, que l interface
      // n affiche nulle part - si bien qu un admin devant deux lignes du meme joueur ne
      // pouvait pas savoir laquelle supprimer.
      //
      // Collection a part, et non un champ du document membre : celui-ci est lisible par
      // tout signed-in, ce qui exposerait l email de chacun a tous les autres. Ici la
      // lecture est reservee a l admin et au titulaire.
      // ------------------------------------------------------------
      match /accounts/{accountId} {
        allow read: if isAdmin() || isSelf(accountId);
        // isMember ajoute le 2026-09-28 : sans lui, tout compte connecte pouvait ecrire
        // dans leagues/<nom invente>/accounts/<son uid>, dans autant de ligues fictives
        // qu il voulait. C etait la seule ecriture accessible hors de la ligue.
        // Corollaire cote appli : l email s enregistre APRES la fiche membre, pas avant.
        allow write: if isSelf(accountId) && isMember(leagueId)
          && hasOnlyKeys(['email', 'updatedAt'])
          && (!('email' in request.resource.data) || isBoundedString(request.resource.data.email, 0, 200));
      }

      // ------------------------------------------------------------
      // INVITATIONS. Entrer dans la ligue se fera sur code, et seul un admin en cree.
      // Un code sert UNE fois. Pose le 2026-09-28 ; tant que la regle d entree de
      // /members n exige pas le code, rien ne change pour personne.
      //
      // Le code EST l identifiant du document, et `get` est ouvert a tout le monde, y
      // compris sans compte : c est la SEULE lecture publique de cette base. Elle existe
      // pour refuser une inscription AVANT meme de creer le compte Firebase, sans quoi
      // des comptes fantomes s accumuleraient. On ne peut demander qu un code qu on
      // connait deja - `list` est reserve aux admins - et le code fait 12 caracteres
      // tires au hasard, soit 32^12 : le deviner n est pas une voie praticable. C est
      // l entropie qui rend cette ouverture sans danger, pas l obscurite.
      //
      // Consommation : la personne inscrit son uid dans usedBy. Elle peut recommencer
      // autant qu elle veut, usedBy restant le sien, mais personne d autre ne le reprend.
      // ------------------------------------------------------------
      match /invites/{code} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isAdmin()
          && hasOnlyKeys(['createdBy', 'createdAt', 'usedBy'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.usedBy == null;
        allow delete: if isAdmin();
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && (!('usedBy' in resource.data) || resource.data.usedBy == null
              || resource.data.usedBy == request.auth.uid);
      }

      // ------------------------------------------------------------
      // EXCLUSIONS. Un document vide suffit : c est la presence de l uid qui compte.
      // Se remplit a la main dans la console Firebase. Lisible par le titulaire - pour que
      // l appli puisse le lui dire plutot que de le laisser devant un refus muet - et par
      // l admin. Personne ne l ecrit depuis le navigateur, pas meme l admin.
      // ------------------------------------------------------------
      match /blocked/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // ============================================================
      // COLLECTIONS MEMBRES-ONLY : lecture ET ecriture reservees aux membres.
      // Un anon (juste signed-in mais pas inscrit) ne peut RIEN voir ici.
      // ============================================================

      match /chat/{msgId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'image', 'voice', 'gif', 'createdAt', 'replyTo'])
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (
               (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500)
               || (request.resource.data.image is string && request.resource.data.image.size() > 0)
               || (request.resource.data.voice is string && request.resource.data.voice.size() > 0)
               || (request.resource.data.gif is string && request.resource.data.gif.size() > 0)
             )
          && (!('text' in request.resource.data)  || isBoundedString(request.resource.data.text, 0, 500))
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 950000))
          && (!('voice' in request.resource.data) || (request.resource.data.voice is string && request.resource.data.voice.size() <= 950000))
          && (!('gif' in request.resource.data)   || (request.resource.data.gif is string && request.resource.data.gif.size() <= 500));
        // Update autorise : (1) auteur qui edite son propre message (text seulement, dans les 5 min),
        // (2) auteur ou admin qui soft-delete (marque deleted:true + snapshot original).
        allow update: if isMember(leagueId) && (
          // Edit auteur : diff limite au champ text + editedAt
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && (!('text' in request.resource.data) || isBoundedString(request.resource.data.text, 1, 500)))
          ||
          // Soft delete : par auteur ou admin, ajoute les champs deleted*
          ((resource.data.uid == request.auth.uid || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'deleted', 'deletedAt', 'deletedBy', 'deletedByName',
                 'deletedOriginalText', 'deletedOriginalImage', 'deletedOriginalVoice', 'deletedOriginalGif'
               ])
            && request.resource.data.deleted == true)
        );
        // Delete hard : conserve pour compatibilite (invites ou messages tres anciens)
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Indicateur "X ecrit..." : chaque user maj son doc avec updatedAt.
      // Auto-expire cote client apres 5s (pas de rules d'expiration).
      match /typing/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow delete: if isSelf(uid) && isMember(leagueId);
        allow write: if isSelf(uid) && isMember(leagueId)
          && hasOnlyKeys(['name', 'updatedAt'])
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 60));
      }

      match /presence/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isSelf(uid) && isMember(leagueId)
          && hasOnlyKeys(['at', 'lastSeen', 'name']);
      }

      // Votes trophees : requiert membre >= 7 jours (anti-manipulation coup rapide)
      match /votes/{voteId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && memberOlderThan(leagueId, request.auth.uid, 7)
          && request.resource.data.voter == request.auth.uid
          && request.resource.data.target != request.auth.uid
          && hasOnlyKeys(['voter', 'target', 'trophy', 'createdAt'])
          && isBoundedString(request.resource.data.trophy, 1, 50)
          && isBoundedString(request.resource.data.target, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.voter == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /photos/{photoId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'image', 'caption', 'sci', 'common', 'createdAt', 'lat', 'lng'])
          && request.resource.data.image is string && request.resource.data.image.size() <= 950000
          && (!('caption' in request.resource.data) || isBoundedString(request.resource.data.caption, 0, 200))
          && (!('name'    in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('sci'     in request.resource.data) || isBoundedString(request.resource.data.sci, 0, 100))
          && (!('common'  in request.resource.data) || isBoundedString(request.resource.data.common, 0, 100));
        allow update: if false;
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /reactions/{rid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'target', 'emoji', 'createdAt'])
          && isBoundedString(request.resource.data.emoji, 1, 8)
          && isBoundedString(request.resource.data.target, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /comments/{cid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'target', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && isBoundedString(request.resource.data.target, 1, 128)
          && (!('name' in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30));
        allow update: if false;
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /requests/{reqId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'name', 'text', 'status', 'createdAt'])
          && isBoundedString(request.resource.data.text, 1, 500)
          && (!('name'   in request.resource.data) || isBoundedString(request.resource.data.name, 0, 30))
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        // Le bouton qui fait tourner le statut est deja reserve a l admin cote appli
        // (app.js, data-status-cycle). La regle disait le contraire : tout membre pouvait
        // changer le statut de N IMPORTE QUELLE demande. Aligne le 2026-09-28.
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (!('status' in request.resource.data) || isBoundedString(request.resource.data.status, 0, 20));
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /requestVotes/{voteId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && hasOnlyKeys(['uid', 'requestId', 'createdAt'])
          && isBoundedString(request.resource.data.requestId, 1, 128);
        allow delete: if isMember(leagueId) && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }

      match /nameChanges/{cid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isMember(leagueId)
          && request.resource.data.byUid == request.auth.uid
          && hasOnlyKeys(['byUid', 'targetUid', 'oldName', 'newName', 'at'])
          && (!('oldName' in request.resource.data) || isBoundedString(request.resource.data.oldName, 0, 60))
          && (!('newName' in request.resource.data) || isBoundedString(request.resource.data.newName, 0, 60));
        allow update, delete: if false;
      }

      match /ebirdCache/{docId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isMember(leagueId)
          && hasOnlyKeys(['url', 'json', 'updatedAt'])
          && isBoundedString(request.resource.data.url, 1, 500)
          && isBoundedString(request.resource.data.json, 0, 100000);
      }

      match /trophyEvents/{eid} {
        allow read: if isMember(leagueId) || isAdmin();
        // create SEUL, plus d update depuis le 2026-09-28. L id de l evenement est
        // deterministe et n importe quel appareil peut le poser - c est le dessin, un
        // trophee qui change de main est detecte par tous les clients a la fois. Mais
        // reecrire un evenement existant n a aucune raison d arriver, et quand ca arrivait
        // ca remettait le champ at a jour : le trophee remontait en tete du fil comme s il
        // venait d etre gagne. Le refus rend ce bug impossible.
        allow create: if isMember(leagueId)
          && hasOnlyKeys(['kind', 'uid', 'name', 'trophyName', 'fromUid', 'fromName', 'fromTrophy', 'toTrophy', 'at'])
          && isBoundedString(request.resource.data.kind, 1, 30)
          && isBoundedString(request.resource.data.uid, 1, 128)
          && (!('name'        in request.resource.data) || isBoundedString(request.resource.data.name, 0, 60))
          && (!('trophyName'  in request.resource.data) || isBoundedString(request.resource.data.trophyName, 0, 80))
          && (!('fromUid'     in request.resource.data) || request.resource.data.fromUid == null || isBoundedString(request.resource.data.fromUid, 0, 128))
          && (!('fromName'    in request.resource.data) || request.resource.data.fromName == null || isBoundedString(request.resource.data.fromName, 0, 60))
          && (!('fromTrophy'  in request.resource.data) || isBoundedString(request.resource.data.fromTrophy, 0, 80))
          && (!('toTrophy'    in request.resource.data) || isBoundedString(request.resource.data.toTrophy, 0, 80));
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /quizStats/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isSelf(uid) && isMember(leagueId);
      }
    }

    // ============================================================
    // Deny-by-default catch-all
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
